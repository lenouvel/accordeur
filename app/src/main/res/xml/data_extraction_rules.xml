<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : sauvegarde cloud et transfert d'appareil des réglages (DataStore). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
